<?php

namespace App\Console\Commands;

use App\Services\OcrProcessingService;
use Illuminate\Console\Command;

use \App\Classes\CommonClass;

class OcrImportReconciliationProcess extends Command
{
    protected $signature = 'ocrautorefreshir:process';

    protected $description = 'Check and store new com. and sale invoices hourly from OCR';

    public function handle(OcrProcessingService $autoRefreshIRService): int
    {
        $this->info('Starting Auto refresh IR from OCR processing...');

        try {
            $commonClass =  new CommonClass();           
            $authUser = $commonClass->getAuthUser(1); 

            $result = $autoRefreshIRService->autoRefreshNewDeclaration($authUser);

            $this->info(
                "Queued {$result['totalSync']} Auto refresh OCR sync datas into IR syncing."
            );

            return self::SUCCESS;

        } catch (\Throwable $e) {

            $this->error(
                'Auto refresh IR sync from OCR processing failed: ' . $e->getMessage()
            );

            report($e);

            return self::FAILURE;
        }
    }


<?php
<?php

namespace App\Jobs;

use Illuminate\Bus\Batchable;
use Illuminate\Bus\Queueable;
use Illuminate\Contracts\Queue\ShouldQueue;
use Illuminate\Foundation\Bus\Dispatchable;
use Illuminate\Queue\InteractsWithQueue;
use Illuminate\Queue\SerializesModels;
use Illuminate\Support\Carbon;
use Illuminate\Support\Facades\Log;

use App\Models\VATRegistration;
use App\Models\OcrPdf;

use App\Classes\CommonClass;

class OcrIrSyncJob implements ShouldQueue
{
    use Batchable;
    use Dispatchable;
    use InteractsWithQueue;
    use Queueable;
    use SerializesModels;

    protected array $pdfIds;

    protected int $vatRegId;

    protected $authUser;

    protected $commonClass;

    /**
     * Create a new job instance.
     */
    public function __construct(
        array $pdfIds,
        int $vatRegId,
        $authUser
    ) {
        $this->pdfIds = $pdfIds;
        $this->vatRegId = $vatRegId;
        $this->authUser = $authUser;

        $this->commonClass = new CommonClass();
    }

    /**
     * Execute the job.
     */
    public function handle(): void
    {
        /*
         * ---------------------------------------------------------
         * Get the VAT registration.
         * ---------------------------------------------------------
         */
        $vatReg = VATRegistration::query()
            ->with('vatregmain')
            ->find($this->vatRegId);

        if (!$vatReg) {

            Log::warning(
                'IR OCR Sync Job - VAT registration not found',
                [
                    'vat_reg_id' => $this->vatRegId,
                    'pdf_ids' => $this->pdfIds,
                ]
            );

            return;
        }

        /*
         * ---------------------------------------------------------
         * Get PDFs belonging to this job.
         * ---------------------------------------------------------
         */
        $pdfs = OcrPdf::query()
            ->with([
                'syncDb' => function ($query) {
                    $query->select([
                        'ocr_pdf_id',
                        'client_no',
                        'client_name',
                        'invoice_date',
                    ]);
                },
            ])
            ->whereIn('id', $this->pdfIds)
            ->get();

        if ($pdfs->isEmpty()) {
            return;
        }

        /*
         * ---------------------------------------------------------
         * Calculate VAT registration period.
         * ---------------------------------------------------------
         */
        if (!$vatReg->service_start) {

            Log::warning(
                'IR OCR Sync Job - Service start missing',
                [
                    'vat_reg_id' => $vatReg->id,
                    'pdf_ids' => $this->pdfIds,
                ]
            );

            return;
        }

        $frequency = $this->commonClass->getFrequency(
            $vatReg->general_periods
        );

        $serviceStart = Carbon::parse(
            $vatReg->service_start
        )->subMonth();

        $serviceEnd = $serviceStart
            ->copy()
            ->addMonths($frequency - 1)
            ->endOfMonth();

        /*
         * ---------------------------------------------------------
         * Process each PDF.
         * ---------------------------------------------------------
         */
        foreach ($pdfs as $pdf) {

            $syncDb = $pdf->syncDb;

            if (!$syncDb) {

                Log::warning(
                    'IR OCR Sync Job - Sync DB record not found',
                    [
                        'ocr_pdf_id' => $pdf->id,
                        'vat_reg_id' => $vatReg->id,
                    ]
                );

                continue;
            }

            /*
             * Make sure the invoice belongs to the VAT
             * registration period.
             *
             * This is an additional safety check.
             */
            if (!$syncDb->invoice_date) {

                Log::warning(
                    'IR OCR Sync Job - Invoice date missing',
                    [
                        'ocr_pdf_id' => $pdf->id,
                        'vat_reg_id' => $vatReg->id,
                    ]
                );

                continue;
            }

            $invoiceDate = Carbon::parse(
                $syncDb->invoice_date
            );

            if (
                !$invoiceDate->betweenIncluded(
                    $serviceStart,
                    $serviceEnd
                )
            ) {

                Log::warning(
                    'IR OCR Sync Job - Invoice outside VAT registration period',
                    [
                        'ocr_pdf_id' => $pdf->id,
                        'vat_reg_id' => $vatReg->id,
                        'invoice_date' => $invoiceDate->toDateString(),
                        'service_start' => $serviceStart->toDateString(),
                        'service_end' => $serviceEnd->toDateString(),
                    ]
                );

                continue;
            }

            /*
             * ---------------------------------------------------------
             * Refresh this specific OCR PDF.
             * ---------------------------------------------------------
             *
             * Passing $pdf->id makes
             * loadImportReconciliationDatasFromNewOcr()
             * use its $ocr_pdf_id branch.
             */
            $this->commonClass
                ->loadImportReconciliationDatasFromNewOcr(
                    $this->authUser,
                    $vatReg,
                    'ocr',
                    null,
                    false,
                    null,
                    null,
                    $pdf->id
                );
        }
    }

    /**
     * Handle failed job.
     */
    public function failed(\Throwable $exception): void
    {
        Log::error(
            'IR OCR Sync Job failed',
            [
                'vat_reg_id' => $this->vatRegId,
                'pdf_ids' => $this->pdfIds,
                'message' => $exception->getMessage(),
                'trace' => $exception->getTraceAsString(),
            ]
        );
    }
}



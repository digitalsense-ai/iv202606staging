shToast('No new data found in OCR.');\n          return;\n        }\n        showRefreshToast('Refreshing in progress…');\n        refreshIntervalId = setInterval(checkOcrStatus, 2000);\n        checkOcrStatus();\n      },\n      error: function error() {\n        resetRefreshButton();\n        showRefreshToast('Error in fetching data from OCR.', 'bg-danger');\n      }\n    });\n  }\n  function checkOcrStatus() {\n    if (refreshFinished || refreshXhr && refreshXhr.readyState !== 4) return;\n    var vatRegId = $('#vat_reg_id').val();\n    refreshXhr = $.ajax({\n      url: declarationInvoiceUrl + vatRegId + '/ocr-status',\n      method: 'GET',\n      success: function success(response) {\n        if (response.status === 'processing') {\n          showRefreshToast('Refreshing in progress…');\n          return;\n        }\n        if (response.status === 'completed') {\n          refreshFinished = true;\n          stopBatchStatusChecks();\n          resetRefreshButton();\n          if (response.result) {\n            var declarationResult = window.drawDtTable(response.result, 'declaration-new-ocr');\n            window.reloadConsolidatedDeclarations(declarationResult);\n          }\n          showRefreshToast('OCR data refreshed successfully.', 'bg-success');\n        }\n      },\n      error: function error(_xhr, status) {\n        if (status === 'abort') return;\n        stopBatchStatusChecks();\n        resetRefreshButton();\n        showRefreshToast('Error in fetching data from OCR.', 'bg-danger');\n      }\n    });\n  }\n  function commentTooltip(item) {\n    if (!item || !item.comment_reason) return '';\n    var reason = escapeHtml(String(item.comment_reason).toUpperCase());\n    var comment = escapeHtml(item.comment || '');\n    return ' data-bs-toggle=\"tooltip\" data-bs-offset=\"0,4\" data-bs-placement=\"top\" data-bs-html=\"true\" title=\"<span>' + reason + '</span><br><span>' + comment + '</span>\"';\n  }\n  function initializeTooltips(container) {\n    $(container).find('[data-bs-toggle=\"tooltip\"]').each(function () {\n      bootstrap.Tooltip.getOrCreateInstance(this);\n    });\n  }\n  function actionMenu(item, type) {\n    if (!item || item.id === '-') return '';\n    var invoiceName = type === 'declaration' ? 'declaration' : type;\n    var invoiceNo = type === 'declaration' ? item.declaration_no : type === 'com' ? item.co_invoice_no : item.invoice_no;\n    var invoiceDate = item.o_declaration_date || item.o_invoice_date || item.invoice_date || '';\n    var commentAction = item.comment_reason ? 'Edit' : 'Add';\n    var commercialData = type === 'sales' ? ' data-cominvoice_id=\"' + escapeHtml(item.cominvoice_id) + '\" data-cominvoice_no=\"' + escapeHtml(item.cominvoice_no) + '\"' : '';\n    var declarationData = typeof item.declaration_index === 'number' ? ' data-declaration_index=\"' + item.declaration_index + '\"' : '';\n    var data = ' data-invoice_name=\"' + invoiceName + '\" data-invoice_id=\"' + escapeHtml(item.id) + '\" data-invoice_no=\"' + escapeHtml(invoiceNo) + '\" data-invoice_date=\"' + escapeHtml(invoiceDate) + '\" data-tab_name=\"first\"' + commercialData + declarationData;\n    var commentMode = item.comment_reason ? 'edit' : 'add';\n    // let actions = '<li><a href=\"javascript:;\" class=\"dropdown-item btn-disregard-declaration-invoice\"' + data +\n    //   ' data-disregard=\"0\" data-insert_type=\"' + commentAction + ' Comment\" data-comment_reason=\"' + escapeHtml(item.comment_reason || '') + '\" data-comment=\"' + escapeHtml(item.comment || '') + '\" data-comment_visiblity=\"' + escapeHtml(item.comment_visiblity || '') + '\">' +\n    //   '<i class=\"bx bx-comment-' + (item.comment_reason ? 'edit' : 'add') + ' me-2\"></i>' + commentAction + ' Comment</a></li>';\n    var actions = '<li><a href=\"javascript:;\" class=\"dropdown-item btn-disregard-declaration-invoice\"' + data + ' data-disregard=\"0\" data-insert_type=\"' + commentMode + '\" data-comment_reason=\"' + escapeHtml(item.comment_reason || '') + '\" data-comment=\"' + escapeHtml(item.comment || '') + '\" data-comment_visiblity=\"' + escapeHtml(item.comment_visiblity || '') + '\">' + '<i class=\"bx bx-comment-' + (item.comment_reason ? 'edit' : 'add') + ' me-2\"></i>' + commentAction + ' Comment</a></li>';\n    if (item.comment_reason) {\n      actions += '<li><a href=\"javascript:;\" class=\"dropdown-item text-danger btn-declaration-invoice-delete-comment\"' + data + '><i class=\"bx bx-comment-x me-2\"></i>Delete Comment</a></li>';\n    }\n    if (type === 'declaration') {\n      //actions += '<li><button type=\"button\" class=\"dropdown-item js-refresh-page\"><i class=\"bx bx-refresh me-2\"></i>Refresh Data</button></li>';\n    } else {\n      actions += '<li><a href=\"javascript:;\" class=\"dropdown-item btn-refresh-invoice\"' + data + '><i class=\"bx bx-refresh me-2\"></i>Refresh Data</a></li>';\n    }\n    if (type === 'com') {\n      var hasMatch = list(item.invoices).length > 0;\n      actions += hasMatch ? '<li><a href=\"javascript:;\" class=\"dropdown-item btn-unmatch-invoice\"' + data + ' data-group_invoice_id=\"' + escapeHtml(item.group_lope_no || '') + '\"><i class=\"bx bx-list-minus me-2\"></i>Unmatch Com. Invoice</a></li>' : '<li><a href=\"javascript:;\" class=\"dropdown-item btn-rematch-declaration-cominvoice\" title=\"Rematch com. invoice\"' + data + ' data-no_of_split=\"' + escapeHtml(item.no_of_split || '') + '\"><i class=\"bx bx-list-plus me-2\"></i>Rematch com. invoice</a></li>';\n      if (item.pdf) {\n        var cargoType = item.country === 'CH' ? 'swissimportreconciliationfiles' : 'cargo_mailbox';\n        actions += '<li><a href=\"javascript:;\" class=\"dropdown-item btn-declaration-cargo-download-pdf\" title=\"View Cargo PDF\"' + data + ' data-cargo_type=\"' + cargoType + '\" data-cargo_file_id=\"' + escapeHtml(item.pdf) + '\"><i class=\"bx bxs-file-pdf text-danger me-2\"></i>View Cargo PDF</a></li>';\n      }\n      actions += '<li><a href=\"javascript:;\" class=\"dropdown-item text-danger btn-disregard-declaration-invoice\"' + data + ' data-disregard=\"1\"><i class=\"bx bx-folder-minus me-2\"></i>Disregard com. invoice</a></li>';\n      actions += '<li><a href=\"javascript:;\" class=\"dropdown-item text-danger btn-disregard-declaration-invoice\"' + data + ' data-disregard=\"1\" data-disregard_type=\"lopeno\"><i class=\"bx bx-folder-minus me-2\"></i>Disregard lope No.</a></li>';\n    }\n    if (type === 'sales') {\n      if (item.pdf) actions += '<li><a href=\"javascript:;\" class=\"dropdown-item btn-declaration-invoice-download-pdf\"' + data + ' data-invoice_xml_id=\"' + escapeHtml(item.pdf) + '\"><i class=\"bx bxs-file-pdf text-danger me-2\"></i>View PDF</a></li>';\n      actions += '<li><a href=\"javascript:;\" class=\"dropdown-item btn-move-declaration-salesinvoice\"' + data + '><i class=\"bx bx-move me-2\"></i>Move sales invoice</a></li>';\n      actions += '<li><a href=\"javascript:;\" class=\"dropdown-item text-danger btn-disregard-declaration-invoice\"' + data + ' data-disregard=\"1\"><i class=\"bx bx-list-minus me-2\"></i>Disregard invoice</a></li>';\n    }\n    return '<div class=\"d-inline-block declaration-action\">' + '<button type=\"button\" class=\"btn btn-sm btn-icon dropdown-toggle hide-arrow\" data-bs-toggle=\"dropdown\" data-bs-boundary=\"viewport\" aria-expanded=\"false\" title=\"Actions\"><i class=\"bx bx-dots-vertical-rounded\"></i></button>' + '<ul class=\"dropdown-menu dropdown-menu-end m-0\">' + actions + '</ul></div>';\n  }\n  function childTable(headers, rows, emptyMessage, className) {\n    var amountHeaders = new Set(['Statistical value', 'Net Amount', 'Net Sum Invoice', 'Net Amount (CHF)', 'Import VAT', 'VAT Amount (CHF)', 'Duties', 'VAT on Duties', 'Adjustment', 'VAT on adjustment', 'Net amount', 'VAT amount', 'VAT amount (CHF)', 'VAT check 25%', 'VAT check 8.1%']);\n    return '<div class=\"p-0\"><div class=\"table-responsive\"><table class=\"table mb-0 ' + className + '\">' + '<thead><tr>' + headers